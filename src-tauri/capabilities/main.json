{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-desktop",
  "description": "Minimum permissions for the bundled ScreenHello main window. Image creation, resource close and clipboard image write permissions support copying exported images to the clipboard.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-desktop-environment",
    "allow-desktop-open-help",
    "allow-desktop-state-status",
    "allow-desktop-set-locale",
    "allow-desktop-pick-files",
    "allow-desktop-read-file",
    "allow-desktop-choose-save-file",
    "allow-desktop-write-file",
    "allow-desktop-release-file",
    "allow-desktop-capture-capability",
    "allow-desktop-list-capture-sources",
    "allow-desktop-capture-source",
    "allow-desktop-capture-primary",
    "allow-desktop-release-capture-sources",
    "allow-desktop-system-status",
    "allow-desktop-subscribe-system-events",
    "allow-desktop-unsubscribe-system-events",
    "allow-desktop-subscribe-exit-requests",
    "allow-desktop-unsubscribe-exit-requests",
    "allow-desktop-resolve-exit-request",
    "core:image:allow-from-bytes",
    "core:resources:allow-close",
    "clipboard-manager:allow-write-image"
  ]
}
