---
const { src, caption } = Astro.props;
const url = `${import.meta.env.BASE_URL}${src.replace(/^\//, '')}`;
---
<figure class="sh-guide-image">
    <a href={url} target="_blank" rel="noopener noreferrer"><img src={url} alt={caption} width="1440" height="960" loading="lazy" /></a>
    <figcaption>{caption}</figcaption>
</figure>
