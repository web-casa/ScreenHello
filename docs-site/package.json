{
  "name": "screenhello-docs",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.5",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.3.2",
    "fumadocs-core": "^16.15.9",
    "fumadocs-ui": "^16.15.9",
    "lucide-react": "^1.45.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "scripts": {
    "build:content": "node ../scripts/build-docs-content.mjs",
    "check:content": "node ../scripts/build-docs-content.mjs --check",
    "build": "pnpm build:content && astro build && node scripts/post-process.mjs",
    "build:only": "astro build",
    "check": "astro sync && tsc --noEmit",
    "dev": "pnpm build:content && astro dev"
  }
}
