{
  "name": "screenhello-docs",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/vite": "4.3.5",
    "astro": "^7.4.13",
    "fumadocs-core": "^16.19.7",
    "fumadocs-ui": "^16.19.7",
    "lucide-react": "^1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "scripts": {
    "build:content": "node ../scripts/build-docs-content.mjs",
    "check:content": "node ../scripts/build-docs-content.mjs --check",
    "build": "pnpm build:content && astro build && node scripts/post-process.mjs",
    "build:only": "astro build",
    "check": "astro sync && tsc --noEmit",
    "dev": "pnpm build:content && astro dev"
  }
}
