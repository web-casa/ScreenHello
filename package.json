{
  "name": "rico-screenshot",
  "version": "1.0.4",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.12.1 <11"
  },
  "type": "module",
  "description": "ScreenHello local-first screenshot editor for the Web.",
  "keywords": [
    "react",
    "image-beautifier",
    "LeaferJs"
  ],
  "module": "lib/image-beautifier.es.js",
  "main": "lib/image-beautifier.es.js",
  "types": "lib/index.d.ts",
  "style": "lib/style.css",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/image-beautifier.es.js",
      "default": "./lib/image-beautifier.es.js"
    },
    "./style.css": "./lib/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "lib/*.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "cross-env NODE_TYPE=lib vite build && node scripts/write-library-types.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.js",
    "test:release:current": "playwright test --config tests/release/playwright.config.js",
    "test:release:minimum-browser": "node tests/release/minimum-browser.mjs",
    "audit:pwa": "node scripts/audit-pwa-build.mjs",
    "audit:pwa:library": "node scripts/audit-pwa-library-boundary.mjs",
    "audit:release:browsers": "node scripts/audit-release-browser-evidence.mjs",
    "audit:licenses": "node scripts/audit-third-party-notices.mjs",
    "test:consumer": "node scripts/prepare-consumer-package.mjs && playwright test --config tests/consumer/playwright.config.js && cross-env SCREENHELLO_CONSUMER_MODE=preview playwright test --config tests/consumer/playwright.config.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "size:report": "node scripts/report-build-size.mjs",
    "preview": "vite preview",
    "prepublishOnly": "node scripts/release-not-configured.mjs",
    "release": "node scripts/release-not-configured.mjs"
  },
  "files": [
    "lib",
    "ASSET_PROVENANCE.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "devDependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@axe-core/playwright": "4.13.0",
    "@ctrl/tinycolor": "^4.1.0",
    "@emoji-mart/data": "^1.2.1",
    "@eslint/js": "9.39.5",
    "@jsquash/avif": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@leafer-in/arrow": "2.2.9",
    "@leafer-in/editor": "2.2.9",
    "@leafer-in/export": "2.2.9",
    "@leafer-in/interface": "2.2.9",
    "@leafer-in/resize": "2.2.9",
    "@leafer-in/scroll": "2.2.9",
    "@leafer-in/text-editor": "2.2.9",
    "@leafer-in/view": "2.2.9",
    "@leafer-in/viewport": "2.2.9",
    "@leafer-ui/core": "2.2.9",
    "@leafer-ui/draw": "2.2.9",
    "@leafer-ui/interface": "2.2.9",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "antd": "6.6.2",
    "clsx": "^2.1.1",
    "cropperjs": "^1.6.2",
    "cross-env": "^10.1.0",
    "emoji-mart": "^5.6.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "leafer-ui": "2.2.9",
    "lodash": "^4.17.21",
    "mage-icons-react": "0.7.0-beta",
    "mobx": "7.0.3",
    "mobx-react-lite": "5.0.3",
    "nanoid": "^6.0.1",
    "react": "19.2.8",
    "react-cropper": "^2.3.3",
    "react-dom": "19.2.8",
    "resize-detector": "^0.3.0",
    "selenium-webdriver": "4.48.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tinykeys": "^2.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "7.4.1"
  },
  "peerDependencies": {
    "@ant-design/cssinjs": ">=2.1.2 <3",
    "antd": ">=6.6.2 <7",
    "mobx": ">=7.0.3 <8",
    "mobx-react-lite": ">=5.0.3 <6",
    "react": ">=19.2.8 <20",
    "react-dom": ">=19.2.8 <20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/web-casa/ScreenHello.git"
  },
  "bugs": {
    "url": "https://github.com/web-casa/ScreenHello/issues"
  },
  "homepage": "https://screenhello.com",
  "license": "MIT"
}
